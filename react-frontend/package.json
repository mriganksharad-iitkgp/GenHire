{
  "name": "react-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.8.4",
    "chart.js": "^4.5.0",
    "lucide-react": "^0.562.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.1.5",
    "socket.io-client": "^4.8.1",
    "three": "0.180.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-face-assets.mjs",
    "predev": "node scripts/prepare-face-assets.mjs",
    "prestart": "node scripts/prepare-face-assets.mjs",
    "prebuild": "node scripts/prepare-face-assets.mjs",
    "prebuild:kiosk": "node scripts/prepare-face-assets.mjs",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:kiosk": "vite build --config vite.kiosk.config.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:ci": "eslint src --ext .js,.jsx --max-warnings 15",
    "test": "node --test src/shared/api/retry.test.mjs src/features/interview/utils/session.test.mjs src/features/interview/utils/faceCapture.test.mjs src/shared/components/layout/navigation.test.mjs src/features/interview/utils/pcmWorklet.test.mjs",
    "test:portals": "node scripts/portal-smoke.mjs",
    "test:interview-ui": "node scripts/interview-usability-smoke.mjs",
    "test:voice-runtime:prepare": "node scripts/build-voice-runtime-smoke.mjs && node scripts/build-interview-runtime-smoke.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn",
      "jsx-a11y/anchor-is-valid": "warn",
      "import/no-anonymous-default-export": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^30.1.2",
    "postcss": "8.5.1",
    "vite": "^5.4.11"
  }
}
