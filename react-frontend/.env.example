# Copy this file to .env and fill in the values below.

# ── Backend API (required) ─────────────────────────────────────────────
# No trailing slash
REACT_APP_API_URL=http://127.0.0.1:5000
REACT_APP_API_BASE=http://127.0.0.1:5000/api

# ── Google OAuth (required) ─────────────────────────────────────────────
# Same Client ID used by the backend's GOOGLE_CLIENT_ID
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Session storage keys (optional — change only for custom naming) ────
REACT_APP_TOKEN_KEY=genhire-token
REACT_APP_USER_KEY=genhire-user

# ── Secure-browser kiosk (optional) ─────────────────────────────────────
# Installer download link offered when the desktop kiosk app isn't installed.
REACT_APP_KIOSK_DOWNLOAD_URL=https://storage.googleapis.com/genhire-downloads/Genhire.exe

# CRA also supports .env.local (personal overrides, gitignored) and
# .env.development / .env.production (mode-specific) — see CRA docs.

# AI provider keys belong only on the backend (Render); never REACT_APP_*.
