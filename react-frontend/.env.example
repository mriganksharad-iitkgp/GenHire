# Copy this file to .env and fill in the values below.

# ── Backend API (required) ─────────────────────────────────────────────
# No trailing slash
REACT_APP_API_URL=http://127.0.0.1:5000
REACT_APP_API_BASE=http://127.0.0.1:5000/api

# ── Google OAuth (required) ─────────────────────────────────────────────
# Same Client ID used by the backend's GOOGLE_CLIENT_ID
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Session storage keys (optional — change only for custom naming) ────
REACT_APP_TOKEN_KEY=genhire-token
REACT_APP_USER_KEY=genhire-user
