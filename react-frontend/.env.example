# API Configuration
REACT_APP_API_BASE=https://product-prototyping-lab-sr9r.onrender.com/api
REACT_APP_API_URL=https://product-prototyping-lab-sr9r.onrender.com
REACT_APP_WEBSOCKET_URL=wss://product-prototyping-lab-sr9r.onrender.com



# Application Configuration
REACT_APP_COMPANY_NAME=companyxyz
REACT_APP_TOKEN_KEY=companyxyz-token
REACT_APP_USER_KEY=companyxyz-user

# Google OAuth Configuration
