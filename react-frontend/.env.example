# ── BACKEND API (required) ─────────────────────────────────────────────
# Your Cloud Run backend URL — no trailing slash
REACT_APP_API_URL=https://hrtech-628047232128.europe-west1.run.app
REACT_APP_API_BASE=https://hrtech-628047232128.europe-west1.run.app/api

# ── GOOGLE OAUTH (required) ────────────────────────────────────────────
# Same Client ID used by the backend GOOGLE_CLIENT_ID
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── SESSION STORAGE KEYS (optional — change only if you want custom names) ──
REACT_APP_TOKEN_KEY=genhire-token
REACT_APP_USER_KEY=genhire-user
