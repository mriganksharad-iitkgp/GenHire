# API Configuration
REACT_APP_API_BASE=http://127.0.0.1:5000/api
REACT_APP_API_URL=http://127.0.0.1:5000
REACT_APP_WEBSOCKET_URL=http://127.0.0.1:5000

# Application Configuration
REACT_APP_COMPANY_NAME=companyxyz
REACT_APP_TOKEN_KEY=companyxyz-token
REACT_APP_USER_KEY=companyxyz-user

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Development Configuration
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=16777216
REACT_APP_ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,gif

# LiveKit Configuration
REACT_APP_LIVEKIT_URL=wss://your-livekit-url.livekit.cloud