# GenHire frontend PRODUCTION public build configuration
# Every REACT_APP_* value is embedded in the browser bundle. No backend secrets belong here.
# Vite preserves the REACT_APP_* naming used by this application.
# Local npm start uses .env; npm run build uses .env.production.
# On Vercel, import only this frontend file into the matching environment and rebuild.
# See docs/environment-configuration.md for the Cloud Run/Vercel flow.

# API and site URLs
# Required backend HTTPS origin in production (no /api or trailing slash); localhost:5000 in development.
REACT_APP_API_URL="https://REPLACE_WITH_BACKEND.run.app"

# Required API URL, exactly REACT_APP_API_URL + /api. Keep these two settings aligned.
REACT_APP_API_BASE="https://REPLACE_WITH_BACKEND.run.app/api"

# Public frontend origin for this environment.
REACT_APP_FRONTEND_URL="https://genhire.in"

# Google sign-in
# Public OAuth web-client ID; must match backend GOOGLE_CLIENT_ID. Never use a Google client secret here.
REACT_APP_GOOGLE_CLIENT_ID="REPLACE_WITH_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"

# Browser session keys
# Browser session-storage key for login token; changing it signs users out on this origin.
REACT_APP_TOKEN_KEY="genhire-token"

# Browser session-storage key for user metadata; keep stable with TOKEN_KEY.
REACT_APP_USER_KEY="genhire-user"

# Secure browser installers
# Public HTTPS URL for the current Windows installer. Upload a tested installer before changing this.
REACT_APP_KIOSK_DOWNLOAD_URL="https://storage.googleapis.com/genhire-downloads/Genhire.exe"

# Optional public Mac installer URL; blank hides Mac download. Do not point it at a Windows exe.
REACT_APP_KIOSK_MAC_DOWNLOAD_URL=""
