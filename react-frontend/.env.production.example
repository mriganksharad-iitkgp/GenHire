# OA OWNER: PUBLIC frontend build profile. Search OWNER ACTION below; see docs/oa_owner_setup_guide.md.
# OA OWNER: Private filled values are preserved. Comments/defaults do not provision services or approve rollout.
# GenHire frontend PRODUCTION (Vercel) public build configuration
# Template: replace placeholders with public values.
# Vercel: import the entire production file into Settings > Environment Variables > Production, then rebuild.
# Local npm start uses .env; npm run build uses .env.production. Platform build variables override files.
# See docs/environment-configuration.md; keep API URLs and the backend OAuth client ID aligned.
# API and frontend origins
# Required backend HTTPS origin in production (no /api or trailing slash); localhost:5000 in development.
# SETUP NOTE: Public API origin: Cloud Run service URL, without /api; local uses http://localhost:5000. Match the intended environment, then rebuild.
REACT_APP_API_URL="https://hrtech-628047232128.europe-west1.run.app"
# Required API URL, exactly REACT_APP_API_URL + /api. Keep these two settings aligned.
# SETUP NOTE: Public API origin plus /api exactly once; takes precedence over API_URL. Copy the matching backend origin, not the Vercel frontend URL.
REACT_APP_API_BASE="https://hrtech-628047232128.europe-west1.run.app/api"
# Public frontend origin for this environment.
# SETUP NOTE: Public website origin: localhost:3000 locally, the intended Vercel/custom domain in production. Match backend FRONTEND_URL/CORS.
REACT_APP_FRONTEND_URL="https://genhire.in"
# Google OAuth (public client ID)
# Public Google OAuth web-client ID; match backend GOOGLE_CLIENT_ID. Add frontend domains in Google Cloud OAuth authorized JavaScript origins.
# SETUP NOTE: Public OAuth WEB client ID from Google Cloud OAuth console; match backend GOOGLE_CLIENT_ID and authorized frontend origins.
REACT_APP_GOOGLE_CLIENT_ID="628047232128-42e5afo318k3da0lilfbjm5ul35pi4f8.apps.googleusercontent.com"
# Browser session storage names
# Browser session-storage key for login token; changing it signs users out on this origin.
# SETUP NOTE: Browser session-storage name only, not a credential. Preserve the existing value to avoid an unintended login-state reset.
REACT_APP_TOKEN_KEY="genhire-token"
# Browser session-storage key for user metadata; keep stable with TOKEN_KEY.
# SETUP NOTE: Browser metadata storage name only; keep aligned with the existing account session configuration.
REACT_APP_USER_KEY="genhire-user"
# Secure browser downloads
# Public HTTPS URL for the current Windows installer. Upload a tested installer before changing this.
# SETUP NOTE: Public HTTPS URL of the uploaded/tested signed Windows OA installer (release 1.3.0). Existing URL presence does not verify its contents; never make an evidence bucket public.
REACT_APP_KIOSK_DOWNLOAD_URL="https://storage.googleapis.com/genhire-downloads/Genhire.exe"
# Optional: blank hides Mac download. Build/sign/publish a compatible Mac installer, then set its HTTPS URL; never use a Windows exe.
# OPTIONAL / ADC: OPTIONAL: leave blank until a real tested/signed Mac installer is published; then set its public HTTPS URL, never a Windows exe.
REACT_APP_KIOSK_MAC_DOWNLOAD_URL=""
