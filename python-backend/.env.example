# Copy this file to .env and fill in the values below.
# See docs/onboarding.md for the minimum set needed to boot locally.

# ── Server ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change-me                      # python -c "import secrets; print(secrets.token_hex(32))"
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FORCE_HTTPS=false

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=hrtech

# ── Auth & JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me                        # python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRATION_DAYS=1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
REQUIRE_EMAIL_VERIFICATION=false                # set true in production

# ── Candidate invites ───────────────────────────────────────────────────
# HMAC key for stored invite tokens — rotating it invalidates every
# outstanding magic link.
INVITE_TOKEN_SECRET=change-me                   # python -c "import secrets; print(secrets.token_urlsafe(32))"
# Default invite access window in days (recruiter picks per batch, 1-60).
# Both the magic link and the burner login expire at the end of this window;
# re-sending an invite refreshes it.
INVITE_DEFAULT_VALIDITY_DAYS=7
INVITE_SCOPED_JWT_TTL_HOURS=4
INVITE_CLEANUP_INTERVAL_HOURS=24

# ── Email ───────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: zeptomail | mailgun | noop (dev-only, no real sends)
EMAIL_PROVIDER=noop
FRONTEND_URL=http://localhost:3000
# EMAIL_FAIL_FAST=true            # crash on bad email config instead of
                                  # falling back to noop (defaults to true
                                  # when FLASK_ENV=production)

ZEPTOMAIL_API_KEY=your-zeptomail-send-key
ZEPTOMAIL_FROM_EMAIL=hiring@your-domain.com
ZEPTOMAIL_FROM_NAME=GenHire

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.mailgun.org
MAILGUN_FROM_EMAIL=noreply@your-domain.mailgun.org
# MAILGUN_FROM_NAME=GenHire

# ── AI / LLM providers ──────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key                  # required — interview question generation

# Optional per-task model overrides — sensible defaults are baked in if unset
# INTERVIEW_LLM_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini        # legacy fallback read by interview settings
# OPENAI_CV_MODEL=gpt-4o-mini
# CV_SCORING_MODEL=gemini-flash-latest
# CV_PARSER_MODEL=gemini-flash-latest
# GROQ_CV_MODEL=llama-3.3-70b-versatile

# Optional AI-generated-text detection (practice/interview answers) — off if unset
# SAPLING_API_KEY=your-sapling-api-key

LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Google Cloud (Storage + Speech-to-Text) ────────────────────────────
# Optional — uploads fall back to local disk and speech features are
# disabled if this isn't set. Path is resolved relative to python-backend/.
# GOOGLE_APPLICATION_CREDENTIALS accepts a file path OR the inline JSON key
# (production sets the JSON directly). Service-specific overrides:
#   GOOGLE_APPLICATION_CREDENTIALS_JSON — inline JSON, wins for speech
#   GCS_SERVICE_ACCOUNT_KEY / GCS_SERVICE_ACCOUNT_JSON — path/JSON, wins for storage
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=gcs-service-account.json

# ── Payments (Razorpay) ─────────────────────────────────────────────────
# Keys: https://dashboard.razorpay.com/app/keys
# Webhook secret: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
PAYMENT_CURRENCY=INR
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Wallet credit grants & per-action deductions
SIGNUP_BONUS_CREDITS=100
CANDIDATE_PRACTICE_CREDITS=30
CANDIDATE_PRACTICE_PROCTORED_CREDITS=50
RECRUITER_AI_JD_CREDITS=10
RECRUITER_REAL_INTERVIEW_CREDITS=30
RECRUITER_REAL_INTERVIEW_PROCTORED_CREDITS=50
# Bulk candidate invites (magic link): credits per invited candidate,
# charged upfront; failed-email rows are auto-refunded.
RECRUITER_INVITE_CREDITS_PER_CANDIDATE=1

# ── Face identity scoring ───────────────────────────────────────────────
# Real interviews similarity-score the live face capture against the
# candidate's uploaded ID card IN THE BACKGROUND (LLM-scored 0-100). The
# score is shown to the recruiter on the candidate card and reports; it
# NEVER blocks the interview for any account type.
#   enforce / monitor — both mean score-only (kept for env compatibility)
#   off               — disable identity checks entirely (no ID card needed)
# FACE_VERIFICATION_MODE=enforce
# FACE_MATCH_THRESHOLD=75

# ── Admin cost statistics: monthly infrastructure/provider figures (INR) ─
# Placeholder values shown on the admin cost page (pro-rated over the
# selected timeline). Update them from each billing console periodically —
# see docs/costfetch.md. GCP and OpenAI switch to REAL fetched spend when
# the "Real billing fetch" section below is configured; the rest stay
# env-entered.
# INFRA_MONTHLY_GCP_CLOUD_RUN_INR=500
# INFRA_MONTHLY_GCP_CLOUD_BUILD_INR=100
# INFRA_MONTHLY_GCP_CLOUD_STORAGE_INR=100
# INFRA_MONTHLY_GCP_ARTIFACT_REGISTRY_INR=100
# INFRA_MONTHLY_GCP_OTHER_INR=0
# INFRA_MONTHLY_VERCEL_INR=0        # Hobby plan = free tier, Rs.0/mo
# INFRA_MONTHLY_MONGODB_INR=0      # free tier right now
# INFRA_MONTHLY_OPENAI_INR=500      # 0 if the key currently has no quota
# INFRA_MONTHLY_GEMINI_INR=0        # 0 while on the Gemini free tier
# INFRA_MONTHLY_GROQ_INR=0          # 0 while on the Groq free tier
# INFRA_MONTHLY_CLOUDFLARE_INR=0   # legacy; shown only if > 0

# ZeptoMail cost is USAGE-BASED: every outbound email is logged and priced.
# 1 credit = Rs.150 = 10,000 emails => Rs.0.015 per email.
ZEPTOMAIL_PER_EMAIL_COST_INR=0.015

# ── Real billing fetch (optional — replaces GCP/OpenAI placeholders above) ─
# GCP: enable Billing -> Billing export -> BigQuery export (Standard usage
# cost) in the GCP Console, grant the backend service account BigQuery Data
# Viewer + Job User, then set the full export table id:
# GCP_BILLING_EXPORT_BQ_TABLE=your-project.billing_export.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
# GCP_BILLING_EXPORT_BQ_LOCATION=   # only if BigQuery misroutes the job location
# OpenAI: ADMIN key with api.usage.read scope (Settings -> Organization ->
# Admin keys) — the inference OPENAI_API_KEY does NOT work for the Costs API:
# OPENAI_ADMIN_API_KEY=
# No official OpenAI balance API exists — mirror the dashboard figure manually:
# OPENAI_CREDIT_BALANCE_USD=

# ── Interview credit refunds ────────────────────────────────────────────
# Interviews are charged at start and refunded (idempotently) when zero
# answers were recorded. A background sweeper also refunds/finalizes
# sessions abandoned mid-interview (closed tab, crash).
#   INTERVIEW_ABANDON_TTL_MINUTES — how long an "active" session may sit idle
#     before the sweeper treats it as abandoned (min 15)
#   INTERVIEW_REFUND_SWEEP_INTERVAL_MINUTES — sweep frequency (min 5)
# INTERVIEW_ABANDON_TTL_MINUTES=120
# INTERVIEW_REFUND_SWEEP_INTERVAL_MINUTES=15

# ── Infra (optional) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0   # shared rate-limit storage; in-memory if unset
# SENTRY_DSN=                          # error tracking; no-op if unset
# INR_PER_USD=83                       # USD->INR rate for admin cost displays
# ENV_FILE= / DOTENV_PATH=             # alternate .env path for env_loader (scripts/CI)
# Dev/test-script-only vars (never needed by the app itself):
#   SMOKE_BASE_URL, SMOKE_CANDIDATE_TOKEN, SMOKE_RECRUITER_TOKEN, TEST_EMAIL,
#   LOAD_TEST_JOB_ID, LOAD_TEST_TOKEN

# --- LLM provider chain: primary -> secondary -> tertiary (aliases: gemini=google) ---
# Change the order here any time; no code changes needed. A provider whose key
# fails or hits quota is skipped (5-min cooldown) and the next one answers.
# Legacy per-slot aliases also work instead of the list:
#   LLM_PRIMARY_PROVIDER / LLM_SECONDARY_PROVIDER / LLM_TERTIARY_PROVIDER
LLM_PROVIDER_PRIORITY=openai,gemini,groq
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_GEMINI_MODEL=gemini-flash-lite-latest
LLM_OPENAI_MODEL=gpt-4o-mini

# LLM face matching (identity card vs interview capture) — vision models per provider
FACE_MATCH_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FACE_MATCH_GEMINI_MODEL=gemini-flash-lite-latest
FACE_MATCH_OPENAI_MODEL=gpt-4o-mini
FACE_MATCH_THRESHOLD=75

# Mobile companion camera (QR pairing + environment recording)
MOBILE_RECORDING_ENABLED=true

# --- Plan pricing & credits (paise; 1 INR = 100 paise) ---
# Synced into MongoDB on every boot, so edit + restart updates the live plans.
PLAN_CANDIDATE_PRO_PRICE_PAISE=49900
PLAN_CANDIDATE_PRO_CREDITS=500
PLAN_CANDIDATE_MAX_PRICE_PAISE=99900
PLAN_CANDIDATE_MAX_CREDITS=1000
PLAN_RECRUITER_PRO_PRICE_PAISE=499900
PLAN_RECRUITER_PRO_CREDITS=5000
PLAN_RECRUITER_MAX_PRICE_PAISE=999900
PLAN_RECRUITER_MAX_CREDITS=10000
