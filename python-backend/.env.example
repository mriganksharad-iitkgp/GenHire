# OPENAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Google API Configuration
GOOGLE_API_KEY=your-google-gemini-api-key-here

# LangChain Configuration
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# TensorFlow Configuration
TF_ENABLE_ONEDNN_OPTS=0

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
DATABASE_NAME=your_database_name

# Email Verification Configuration
REQUIRE_EMAIL_VERIFICATION=true #Set to false to disable email verification requirement

# Email Provider Selection: 'zeptomail', 'mailgun', or 'noop' (dev-only)
EMAIL_PROVIDER=zeptomail

# ZeptoMail (primary)
ZEPTOMAIL_API_KEY=your-zeptomail-send-key-here
ZEPTOMAIL_FROM_EMAIL=hiring@your-domain.com
ZEPTOMAIL_FROM_NAME=GenHire

# Mailgun (legacy fallback; only required when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
MAILGUN_FROM_EMAIL=noreply@your-mailgun-domain.mailgun.org

FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Candidate Invite System
# Used as HMAC component when hashing invite tokens for storage; rotate to invalidate all outstanding magic links.
INVITE_TOKEN_SECRET=change-me-run-python-c-import-secrets-print-secrets-token_urlsafe-32
# Magic-link expiry (in minutes) sent to invited candidates.
INVITE_MAGIC_LINK_TTL_MIN=30
# JWT TTL (hours) for the post-redeem handoff token. After this, user logs in via username + password.
INVITE_SCOPED_JWT_TTL_HOURS=4
# Cleanup cadence (hours) for the daemon that purges dormant temp accounts older than 30 days.
INVITE_CLEANUP_INTERVAL_HOURS=24

# JWT Configuration  
JWT_SECRET_KEY=your-secure-secret-key-here-change-this
JWT_EXPIRATION_DAYS=1

# -----------------------------------------------------
# Razorpay Configuration (Required)
# -----------------------------------------------------
# Get these from https://dashboard.razorpay.com/app/keys

# Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=rzp_test_S6C0kjbjNMJRLP

# Key Secret
RAZORPAY_KEY_SECRET=Rhn5DxdWZME9DHx3xnHrQtTR

# Webhook secret
# Get from https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# -----------------------------------------------------
# Application URLs (Required for redirects)
# -----------------------------------------------------
FRONTEND_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your-flask-secret-key-change-this
FLASK_DEBUG=False

# Server Configuration
HOST=127.0.0.1
PORT=5000

# API Keys
GROQ_API_KEY=your-groq-api-key-here

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,gif

# File Paths
JD_FOLDER=uploads/jd
CV_FOLDER=uploads/cv
PROCTORING_FOLDER=uploads/proctoring
PHOTOS_FOLDER=uploads/photos

# CORS Configuration
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# LiveKit Configuration (for video interviews)
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# Deepgram Configuration (for speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Sapling API for AI Detection
SAPLING_API_KEY=YOUR_SAPLING_API_KEY

# Google Cloud Storage Configuration
GOOGLE_APPLICATION_CREDENTIALS=your-service-account-key.json
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_SERVICE_ACCOUNT_KEY=your-service-account-key.json
