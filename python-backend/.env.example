# OPENAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Google API Configuration
GOOGLE_API_KEY=your-google-gemini-api-key-here

# LangChain Configuration
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# TensorFlow Configuration
TF_ENABLE_ONEDNN_OPTS=0

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
DATABASE_NAME=your_database_name

# Email Verification Configuration
REQUIRE_EMAIL_VERIFICATION=true #Set to false to disable email verification requirement
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
MAILGUN_FROM_EMAIL=noreply@your-mailgun-domain.mailgun.org
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Configuration  
JWT_SECRET_KEY=your-secure-secret-key-here-change-this
JWT_EXPIRATION_DAYS=1

# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your-flask-secret-key-change-this
FLASK_DEBUG=False

# Server Configuration
HOST=127.0.0.1
PORT=5000

# API Keys
GROQ_API_KEY=your-groq-api-key-here

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,gif

# File Paths
JD_FOLDER=uploads/jd
CV_FOLDER=uploads/cv
PROCTORING_FOLDER=uploads/proctoring
PHOTOS_FOLDER=uploads/photos

# CORS Configuration
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# LiveKit Configuration (for video interviews)
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# Deepgram Configuration (for speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
