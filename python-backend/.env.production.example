# GenHire backend PRODUCTION (Cloud Run) configuration
# Template: fill required placeholders; no working secrets.
# Import the entire production file into Cloud Run Variables & Secrets; never into Vercel.
# Values injected by the platform override dotenv. No export prefixes; all assignments stay on one line.
# Cloud Run supplies PORT and Google ADC identity; Google ADC overrides remain empty in production.
# Fill required blank settings first. See docs/required-setup-and-rate-limits.md and docs/environment-configuration.md.
# ============================================================================
# 01 Runtime and frontend origins
# ============================================================================
# Required. development locally; production on Cloud Run. Enables production guards.
FLASK_ENV="production"
# Required comma-separated browser origins, no paths/trailing slash. Include actual frontend domains.
CORS_ORIGINS="https://genhire.in,https://www.genhire.in,https://gen-hire-gamma.vercel.app"
# false for local HTTP. true in production for HTTPS redirects and HSTS behind the Cloud Run proxy.
FORCE_HTTPS="true"
# Required public frontend origin for links in email. Local: http://localhost:3000; production: your HTTPS domain.
FRONTEND_URL="https://genhire.in"
# Local python app.py only: 0 starts once; 1 enables automatic reload. Gunicorn ignores this.
GENHIRE_DEV_RELOAD="0"
# ============================================================================
# 02 MongoDB connection and pool
# ============================================================================
# Required MongoDB connection string, including credentials when needed. Grant database access/network access.
MONGODB_URI="mongodb+srv://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_CLUSTER/REPLACE_WITH_DATABASE"
# Required logical database name. Keep it aligned with the intended local/production data.
DATABASE_NAME="hrtech"
# Maximum MongoDB connections per process.
MONGO_MAX_POOL_SIZE="50"
# Milliseconds to wait for a pooled database connection before failing gracefully.
MONGO_WAIT_QUEUE_TIMEOUT_MS="2000"
# Database server-selection timeout in milliseconds.
MONGO_SERVER_SELECTION_TIMEOUT_MS="5000"
# ============================================================================
# 03 Authentication, OAuth and invitation security
# ============================================================================
# Required secret for Flask sessions. Use a stable random value; changing it invalidates sessions.
FLASK_SECRET_KEY="REPLACE_WITH_STABLE_RANDOM_SECRET"
# Required secret signing login tokens. Keep it stable and private; rotating it signs users out.
JWT_SECRET_KEY="REPLACE_WITH_STABLE_RANDOM_SECRET"
# Login token lifetime in days.
JWT_EXPIRATION_DAYS="1"
# Public OAuth web-client ID. Must match frontend REACT_APP_GOOGLE_CLIENT_ID and authorized origins.
GOOGLE_CLIENT_ID="REPLACE_WITH_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
# true requires email verification. Configure a working mail provider first.
REQUIRE_EMAIL_VERIFICATION="true"
# Secret signing invitation links. Keep stable so existing links remain valid.
INVITE_TOKEN_SECRET="REPLACE_WITH_STABLE_RANDOM_SECRET"
# Invitation validity, in days.
INVITE_DEFAULT_VALIDITY_DAYS="7"
# Lifetime, in hours, for the limited invitation session.
INVITE_SCOPED_JWT_TTL_HOURS="4"
# Invitation cleanup interval, in hours.
INVITE_CLEANUP_INTERVAL_HOURS="24"
# ============================================================================
# 04 External API keys and webhook secrets (backend only)
# ============================================================================
# AI secret: create/fund a DeepSeek API key at platform.deepseek.com. Blank disables the primary route; Gemini/Groq can fall back.
DEEPSEEK_API_KEY=""
# AI/speech secret: create at console.groq.com/keys. Required for Groq fallback and interview transcription.
GROQ_API_KEY=""
# Gemini AI secret: create in Google AI Studio (aistudio.google.com/apikey); enable billing/quota. This is not the OAuth client ID.
GOOGLE_API_KEY=""
# Email secret: copy the send-mail token from a verified ZeptoMail Mail Agent. Required when EMAIL_PROVIDER=zeptomail.
ZEPTOMAIL_API_KEY=""
# Payment API key ID: Razorpay Dashboard > API Keys. Pair test/live ID and secret from the same mode.
RAZORPAY_KEY_ID=""
# Payment secret paired with RAZORPAY_KEY_ID. Generate/retrieve the pair in Razorpay Dashboard; backend only.
RAZORPAY_KEY_SECRET=""
# Webhook secret: Razorpay Dashboard > Webhooks > backend /api/payment/webhooks/razorpay. Set the same signing secret here; API secret is different.
RAZORPAY_WEBHOOK_SECRET=""
# Optional LangSmith tracing secret: create in smith.langchain.com Settings > API Keys. Required if LANGCHAIN_TRACING_V2=true.
LANGCHAIN_API_KEY=""
# Optional error monitoring: create a backend project in Sentry and copy its DSN. Blank disables external reporting.
SENTRY_DSN=""
# ============================================================================
# 05 Cloud Storage signing and Google service identity
# ============================================================================
# Required bucket name: create/select a GCS bucket and grant the signing account access. Enable Cloud Storage and Text-to-Speech APIs.
GCS_BUCKET_NAME="REPLACE_WITH_GCS_BUCKET"
# Storage signing secret: single-line service-account JSON with escaped newlines. On Cloud Run use Secret Manager; local ADC path can supply signing instead. Required in production unless a signing key file is mounted.
GCS_SERVICE_ACCOUNT_JSON=""
# Optional alternative to signing JSON: mounted service-account file, e.g. /secrets/gcs.json. Blank is correct when JSON or local ADC supplies it.
GCS_SERVICE_ACCOUNT_KEY=""
# Google ADC file-path override: keep empty on Cloud Run to use its attached service account.
GOOGLE_APPLICATION_CREDENTIALS=""
# Google speech/billing inline-JSON override: keep empty on Cloud Run to use its attached service account.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
# ============================================================================
# 06 Email delivery settings (ZeptoMail)
# ============================================================================
# Active mail provider: zeptomail or mailgun. Only that provider requires its credentials.
EMAIL_PROVIDER="zeptomail"
# Verified sender address for ZeptoMail.
ZEPTOMAIL_FROM_EMAIL="no-reply@example.com"
# Human-readable email sender name.
ZEPTOMAIL_FROM_NAME="GenHire"
# true reports email-provider failures immediately rather than silently accepting failed delivery.
EMAIL_FAIL_FAST="false"
# ============================================================================
# 07 AI provider order and text models
# ============================================================================
# Single authoritative text-provider order: deepseek,gemini,groq. Missing keys skip their route; no OpenAI generation is selected.
LLM_PROVIDER_PRIORITY="deepseek,gemini,groq"
# DeepSeek API endpoint; do not include a model name.
DEEPSEEK_API_BASE="https://api.deepseek.com"
# Text model for the named provider; model access and funded credentials are required.
LLM_DEEPSEEK_MODEL="deepseek-flash"
# S2 uses disabled to reduce latency; do not change without checking provider support and cost.
DEEPSEEK_THINKING_MODE="disabled"
# Text model for the named provider; model access and funded credentials are required.
LLM_GEMINI_MODEL="gemini-3.1-flash-lite"
# Groq-hosted text model; openai/gpt-oss-20b uses GROQ_API_KEY and does not need an OpenAI API key.
LLM_GROQ_MODEL="openai/gpt-oss-20b"
# Interview text-generation model. Must be supported by the selected provider.
INTERVIEW_LLM_MODEL="deepseek-flash"
# Explicit Gemini model override for structured CV parsing; requires GOOGLE_API_KEY. Other configured providers remain fallbacks.
CV_PARSER_MODEL="gemini-3.1-flash-lite"
# ============================================================================
# 08 Interview transcription and speech
# ============================================================================
# Speech-to-text provider. Current S2 flow uses groq.
STT_PROVIDER="groq"
# Groq transcription model; requires GROQ_API_KEY.
GROQ_STT_MODEL="whisper-large-v3-turbo"
# Google Cloud Standard voice for spoken interview questions. Enable Text-to-Speech API/billing.
GOOGLE_TTS_VOICE="en-US-Standard-C"
# ============================================================================
# 09 Identity, monitoring and phone companion
# ============================================================================
# Optional Groq vision override; blank skips Groq face comparison. GPT-OSS is text-only; choose a supported image model before filling.
FACE_MATCH_GROQ_MODEL=""
# Identity/face comparison model; it must support image input for this provider.
FACE_MATCH_GEMINI_MODEL="gemini-3.1-flash-lite"
# Face matching acceptance threshold; preserve the existing scale/operating setting.
FACE_MATCH_THRESHOLD="75"
# Face verification mode. Keep it aligned with the available verification services.
FACE_VERIFICATION_MODE="enforce"
# Identity/face comparison model; it must support image input for this provider.
FACE_MATCH_DEEPSEEK_MODEL="deepseek-flash"
# Minimum monitoring frame interval, in milliseconds.
PROCTORING_FRAME_INTERVAL_MS="700"
# Optional ONNX weight path; blank uses models/proctoring/yolov8n.onnx. Include that gitignored artifact in the deployed image.
PROCTORING_OBJECT_MODEL_PATH=""
# Comma-separated object labels to flag. Must match the configured object model labels.
PROCTORING_PROHIBITED_OBJECTS="cell phone,book"
# Enable identity checks during monitoring when supported.
PROCTORING_IDENTITY_ENABLED="true"
# true enables phone pairing/second-camera recording; verify companion flow before enabling jobs that require it. false blocks that setup.
MOBILE_RECORDING_ENABLED="false"
# ============================================================================
# 10 Payment currency and return URLs
# ============================================================================
# Payment currency, e.g. INR.
PAYMENT_CURRENCY="INR"
# Frontend payment-return URL. Confirmation still comes from verified backend/payment history.
PAYMENT_SUCCESS_URL="https://genhire.in/payment/success"
# Frontend payment-cancel return URL.
PAYMENT_CANCEL_URL="https://genhire.in/payment/cancel"
# ============================================================================
# 11 Wallet prices, credits and refunds
# ============================================================================
# Wallet credits for this plan/action. Preserve the configured billing schedule.
SIGNUP_BONUS_CREDITS="100"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
CANDIDATE_PRACTICE_CREDITS="30"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
CANDIDATE_PRACTICE_PROCTORED_CREDITS="50"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
RECRUITER_AI_JD_CREDITS="10"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
RECRUITER_REAL_INTERVIEW_CREDITS="30"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
RECRUITER_REAL_INTERVIEW_PROCTORED_CREDITS="50"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
RECRUITER_INVITE_CREDITS_PER_CANDIDATE="1"
# Minutes before an inactive unfinished interview can be treated as abandoned.
INTERVIEW_ABANDON_TTL_MINUTES="120"
# Minutes between abandoned-interview refund sweeps.
INTERVIEW_REFUND_SWEEP_INTERVAL_MINUTES="15"
# Wallet recharge price in paise (100 paise = INR 1). Keep backend pricing authoritative.
PLAN_CANDIDATE_PRO_PRICE_PAISE="49900"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
PLAN_CANDIDATE_PRO_CREDITS="500"
# Wallet recharge price in paise (100 paise = INR 1). Keep backend pricing authoritative.
PLAN_CANDIDATE_MAX_PRICE_PAISE="99900"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
PLAN_CANDIDATE_MAX_CREDITS="1000"
# Wallet recharge price in paise (100 paise = INR 1). Keep backend pricing authoritative.
PLAN_RECRUITER_PRO_PRICE_PAISE="499900"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
PLAN_RECRUITER_PRO_CREDITS="5000"
# Wallet recharge price in paise (100 paise = INR 1). Keep backend pricing authoritative.
PLAN_RECRUITER_MAX_PRICE_PAISE="999900"
# Wallet credits for this plan/action. Preserve the configured billing schedule.
PLAN_RECRUITER_MAX_CREDITS="10000"
# ============================================================================
# 12 Redis quotas and request budgets
# ============================================================================
# Production-required shared quotas: create managed Redis (Upstash TCP or Memorystore), copy its read/write redis(s):// URL. See docs/required-setup-and-rate-limits.md sections 3-6.
REDIS_URL=""
# Quota key prefix: use separate genhire-local and genhire-production namespaces when sharing Redis.
RATE_LIMIT_NAMESPACE="genhire-production"
# Broad per-network request ceiling per fixed 60-second window. Individual/account policies apply too.
RATE_LIMIT_NETWORK_CALLS="3000"
# Maximum local in-memory quota keys before protection rejects work.
RATE_LIMIT_MEMORY_KEYS="20000"
# Trusted X-Forwarded-For proxy count. 0 ignores forwarded IPs. Set only after confirming and restricting your actual proxy chain.
TRUSTED_PROXY_HOPS="0"
# Maximum auth requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_AUTH_CALLS="120"
# Time window in seconds for auth requests.
RATE_LIMIT_AUTH_WINDOW_SECONDS="60"
# Maximum account requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_ACCOUNT_CALLS="600"
# Time window in seconds for account requests.
RATE_LIMIT_ACCOUNT_WINDOW_SECONDS="60"
# Maximum login requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_LOGIN_CALLS="10"
# Time window in seconds for login requests.
RATE_LIMIT_LOGIN_WINDOW_SECONDS="60"
# Maximum register requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_REGISTER_CALLS="5"
# Time window in seconds for register requests.
RATE_LIMIT_REGISTER_WINDOW_SECONDS="300"
# Maximum email requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_EMAIL_CALLS="3"
# Time window in seconds for email requests.
RATE_LIMIT_EMAIL_WINDOW_SECONDS="300"
# Maximum invite redeem requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_INVITE_REDEEM_CALLS="20"
# Time window in seconds for invite redeem requests.
RATE_LIMIT_INVITE_REDEEM_WINDOW_SECONDS="300"
# Maximum application requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_APPLICATION_CALLS="5"
# Time window in seconds for application requests.
RATE_LIMIT_APPLICATION_WINDOW_SECONDS="60"
# Maximum application hour requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_APPLICATION_HOUR_CALLS="30"
# Time window in seconds for application hour requests.
RATE_LIMIT_APPLICATION_HOUR_WINDOW_SECONDS="3600"
# Maximum ai requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_AI_CALLS="10"
# Time window in seconds for ai requests.
RATE_LIMIT_AI_WINDOW_SECONDS="300"
# Maximum upload requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_UPLOAD_CALLS="12"
# Time window in seconds for upload requests.
RATE_LIMIT_UPLOAD_WINDOW_SECONDS="300"
# Maximum invite send requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_INVITE_SEND_CALLS="5"
# Time window in seconds for invite send requests.
RATE_LIMIT_INVITE_SEND_WINDOW_SECONDS="300"
# Maximum interview start requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_INTERVIEW_START_CALLS="4"
# Time window in seconds for interview start requests.
RATE_LIMIT_INTERVIEW_START_WINDOW_SECONDS="300"
# Maximum interview answer requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_INTERVIEW_ANSWER_CALLS="60"
# Time window in seconds for interview answer requests.
RATE_LIMIT_INTERVIEW_ANSWER_WINDOW_SECONDS="60"
# Maximum interview setup requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_INTERVIEW_SETUP_CALLS="60"
# Time window in seconds for interview setup requests.
RATE_LIMIT_INTERVIEW_SETUP_WINDOW_SECONDS="60"
# Maximum telemetry requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_TELEMETRY_CALLS="600"
# Time window in seconds for telemetry requests.
RATE_LIMIT_TELEMETRY_WINDOW_SECONDS="60"
# Maximum speech requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SPEECH_CALLS="120"
# Time window in seconds for speech requests.
RATE_LIMIT_SPEECH_WINDOW_SECONDS="60"
# Maximum speech token requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SPEECH_TOKEN_CALLS="20"
# Time window in seconds for speech token requests.
RATE_LIMIT_SPEECH_TOKEN_WINDOW_SECONDS="60"
# Maximum payment requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_PAYMENT_CALLS="20"
# Time window in seconds for payment requests.
RATE_LIMIT_PAYMENT_WINDOW_SECONDS="300"
# Maximum socket connect requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SOCKET_CONNECT_CALLS="120"
# Time window in seconds for socket connect requests.
RATE_LIMIT_SOCKET_CONNECT_WINDOW_SECONDS="60"
# Maximum socket control requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SOCKET_CONTROL_CALLS="120"
# Time window in seconds for socket control requests.
RATE_LIMIT_SOCKET_CONTROL_WINDOW_SECONDS="60"
# Maximum socket frame requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SOCKET_FRAME_CALLS="180"
# Time window in seconds for socket frame requests.
RATE_LIMIT_SOCKET_FRAME_WINDOW_SECONDS="60"
# Maximum socket status requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_SOCKET_STATUS_CALLS="60"
# Time window in seconds for socket status requests.
RATE_LIMIT_SOCKET_STATUS_WINDOW_SECONDS="60"
# Maximum export requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_EXPORT_CALLS="10"
# Time window in seconds for export requests.
RATE_LIMIT_EXPORT_WINDOW_SECONDS="300"
# Maximum read requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_READ_CALLS="240"
# Time window in seconds for read requests.
RATE_LIMIT_READ_WINDOW_SECONDS="60"
# Maximum write requests per matching WINDOW_SECONDS, per identity/account policy.
RATE_LIMIT_WRITE_CALLS="60"
# Time window in seconds for write requests.
RATE_LIMIT_WRITE_WINDOW_SECONDS="60"
# false permits bounded local memory quotas; true requires reachable Redis in production. Do not bypass this guard to deploy.
RATE_LIMIT_REQUIRE_REDIS="true"
# ============================================================================
# 13 Capacity and bounded background workers
# ============================================================================
# Maximum concurrent api work per process; excess requests receive a retryable busy response.
API_MAX_INFLIGHT="128"
# Maximum concurrent ai work per process; excess requests receive a retryable busy response.
AI_MAX_INFLIGHT="6"
# Maximum concurrent upload work per process; excess requests receive a retryable busy response.
UPLOAD_MAX_INFLIGHT="8"
# Maximum concurrent speech work per process; excess requests receive a retryable busy response.
SPEECH_MAX_INFLIGHT="12"
# Maximum concurrent interview start work per process; excess requests receive a retryable busy response.
INTERVIEW_START_MAX_INFLIGHT="6"
# Maximum concurrent invite work per process; excess requests receive a retryable busy response.
INVITE_MAX_INFLIGHT="2"
# Number of local durable CV-scoring workers; tune to CPU/provider quotas.
CV_SCORING_WORKERS="2"
# Durable scoring lease duration in seconds.
CV_SCORING_LEASE_SECONDS="300"
# Durable scoring polling interval in seconds.
CV_SCORING_POLL_SECONDS="2"
# Bounded notification worker count.
NOTIFICATION_WORKERS="4"
# Maximum queued notifications; bounds local memory.
NOTIFICATION_QUEUE_SIZE="128"
# Maximum concurrent proctoring work per process; excess requests receive a retryable busy response.
PROCTORING_MAX_INFLIGHT="4"
# Maximum concurrent Socket.IO connections per process.
SOCKET_MAX_CONNECTIONS="2000"
# Maximum accepted Socket.IO message size in bytes.
SOCKET_MAX_MESSAGE_BYTES="2097152"
# Maximum concurrent background invitation jobs.
INVITE_BACKGROUND_MAX_INFLIGHT="2"
# Maximum candidates in an invitation batch.
INVITE_MAX_BATCH_SIZE="2000"
# ============================================================================
# 14 Provider pricing estimates (reporting only)
# ============================================================================
# Configured USD-to-INR conversion for estimates; does not alter gateway currency/charges.
INR_PER_USD="96"
# Estimated email unit cost in INR for statistics.
ZEPTOMAIL_PER_EMAIL_COST_INR="0.015"
# Chosen reporting pricing mode. Preserve the configured S2 estimate; verify provider pricing before updating.
DEEPSEEK_PRICING_MODE="peak"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
DEEPSEEK_INPUT_USD_PER_1M="0.30"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
DEEPSEEK_CACHED_INPUT_USD_PER_1M="0.006"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
DEEPSEEK_OUTPUT_USD_PER_1M="1.20"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
GEMINI_INPUT_USD_PER_1M="0.25"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
GEMINI_OUTPUT_USD_PER_1M="1.50"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
GROQ_INPUT_USD_PER_1M="0.075"
# Reporting estimate in USD per one million tokens; verify provider rates before changing.
GROQ_OUTPUT_USD_PER_1M="0.30"
# Reporting estimate in USD per audio hour, with current per-request minimum billing.
GROQ_STT_USD_PER_HOUR="0.04"
# ============================================================================
# 15 Infrastructure estimates and billing export
# ============================================================================
# Optional monthly cost estimate in INR for gcp cloud run. Reporting only.
INFRA_MONTHLY_GCP_CLOUD_RUN_INR="0"
# Optional monthly cost estimate in INR for gcp cloud build. Reporting only.
INFRA_MONTHLY_GCP_CLOUD_BUILD_INR="0"
# Optional monthly cost estimate in INR for gcp cloud storage. Reporting only.
INFRA_MONTHLY_GCP_CLOUD_STORAGE_INR="0"
# Optional monthly cost estimate in INR for gcp artifact registry. Reporting only.
INFRA_MONTHLY_GCP_ARTIFACT_REGISTRY_INR="0"
# Optional monthly cost estimate in INR for gcp compute engine. Reporting only.
INFRA_MONTHLY_GCP_COMPUTE_ENGINE_INR="0"
# Optional monthly cost estimate in INR for gcp vm manager. Reporting only.
INFRA_MONTHLY_GCP_VM_MANAGER_INR="0"
# Optional monthly cost estimate in INR for gcp networking. Reporting only.
INFRA_MONTHLY_GCP_NETWORKING_INR="0"
# Optional monthly cost estimate in INR for gcp other. Reporting only.
INFRA_MONTHLY_GCP_OTHER_INR="0"
# Optional monthly cost estimate in INR for vercel. Reporting only.
INFRA_MONTHLY_VERCEL_INR="0"
# Optional monthly cost estimate in INR for mongodb. Reporting only.
INFRA_MONTHLY_MONGODB_INR="0"
# Optional monthly cost estimate in INR for gemini. Reporting only.
INFRA_MONTHLY_GEMINI_INR="0"
# Optional monthly cost estimate in INR for groq. Reporting only.
INFRA_MONTHLY_GROQ_INR="0"
# Optional monthly cost estimate in INR for cloudflare. Reporting only.
INFRA_MONTHLY_CLOUDFLARE_INR="0"
# Optional live cost reporting: enable GCP Billing > BigQuery export; set project.dataset.table and grant the runtime account read/query access.
GCP_BILLING_EXPORT_BQ_TABLE="hr-tech-2026.billing_export.gcp_billing_export_v1_01463B_C70BB7_716BAA"
# Optional BigQuery dataset region (e.g. EU); blank lets the billing client infer the location.
GCP_BILLING_EXPORT_BQ_LOCATION=""
# ============================================================================
# 16 Optional tracing controls
# ============================================================================
# Optional prompt/response tracing switch. true needs LANGCHAIN_API_KEY; false disables tracing. Keep production intent explicit.
LANGCHAIN_TRACING_V2="false"
# Optional tracing service endpoint.
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
