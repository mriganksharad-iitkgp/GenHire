SPHERE_RUNTIME_PROFILES_JSON="{}"
# OWNER ACTION: Ask Sphere account admin/support for the approved positive integer master judge ID used by Problems acceptance.
# LOOKUP: From backend run python scripts/admin/discover_sphere_account.py; see docs/oa_sphere_sql_setup.md.
SPHERE_MASTER_JUDGE_ID=""
# OWNER ACTION: Ask Sphere account admin/support for the approved positive integer testcase judge ID; do not guess defaults.
# LOOKUP: From backend run python scripts/admin/discover_sphere_account.py; see docs/oa_sphere_sql_setup.md.
SPHERE_TESTCASE_JUDGE_ID=""
# OWNER ACTION: Google Cloud Console project selector > existing GenHire PROJECT ID, not display name/project number. Use the project where SQL jobs are deployed.
GENHIRE_SQL_PROJECT=""
# SAFE DEFAULT: Approved Belgium region; current SQL adapter requires exactly europe-west1.
GENHIRE_SQL_REGION="europe-west1"
# OWNER ACTION: After infra/oa_sql Terraform apply, copy artifact_bucket output: bare private bucket name, no gs://. Separate from application evidence bucket.
GENHIRE_SQL_ARTIFACT_BUCKET=""
# SAFE DEFAULT: Planned Terraform job name, not proof it exists. Deploy/verify the PostgreSQL 17 job in the selected project/region.
GENHIRE_SQL_POSTGRESQL_JOB="genhire-oa-sql-postgresql"
# SAFE DEFAULT: Planned Terraform job name, not proof it exists. Deploy/verify the MySQL 8.4 job in the selected project/region.
GENHIRE_SQL_MYSQL_JOB="genhire-oa-sql-mysql"
# SAFE DEFAULT: Hard pilot range 1-200 dispatches per UTC month, including preflight/uncertain dispatches; not number of candidates.
GENHIRE_SQL_MONTHLY_EXECUTION_LIMIT="200"
# SAFE DEFAULT: Hard pilot range 1-500 submissions/month including reference validation/preflight/public/final cases; see renewal/quota blocker in owner guide.
GENHIRE_SPHERE_MONTHLY_SUBMISSION_LIMIT="500"
# SAFE DEFAULT: Pilot SQL concurrency is fixed globally at one across both engines; this does not enable higher capacity.
GENHIRE_SQL_MAX_CONCURRENT_EXECUTIONS="1"
# SAFE DEFAULT: Pilot SQL Cloud Run task timeout is fixed at 60 seconds; keep deployment consistent.
GENHIRE_SQL_TASK_TIMEOUT_SECONDS="60"
# SAFE DEFAULT: SQL-only monthly target, not a spending cap. Verify real Cloud Billing alerts; worker/AI/Sphere costs are separate.
GENHIRE_SQL_MONTHLY_BUDGET_USD="10"
# SAFE DEFAULT: Enable after funded supported AI credentials/JSON quality and authoring/practice workers are verified.
GENHIRE_ASSESSMENT_GENERATION_ENABLED="false"
# COMPATIBILITY ONLY: AI drafting/regeneration now uses RECRUITER_AI_JD_CREDITS for one shared authoring price.
GENHIRE_OA_REGENERATION_CREDITS="10"
# OWNER ACTION: Choose a versioned ID only after an actual sandbox/image isolation review. Must match policy_id in private security-review JSON; no guessed approval.
GENHIRE_EXECUTOR_ISOLATION_POLICY_ID=""
# SAFE DEFAULT: Enable only with active scheduler, correct timezone/windows and scoped workflow verification.
GENHIRE_SCHEDULING_ENABLED="false"
# SAFE DEFAULT: Enable last, after verified sender, approved recipients/content and unknown-delivery tests. Scheduler and company email workers are separate.
GENHIRE_HIRING_EMAILS_ENABLED="false"
# SAFE DEFAULT: Keep off until actual grading/security acceptance and integrity/worker readiness. Disabling new starts must not stop accepted saves/deadlines.
GENHIRE_OA_RUNTIME_ENABLED="false"
# SAFE DEFAULT: Operator assertion ONLY after actual grading/failure/billing acceptance; a test double or key is not acceptance.
GENHIRE_OA_EVALUATION_ACCEPTED="false"
# SAFE DEFAULT: Operator assertion ONLY after secure launch/device/scoped-token/isolation and accommodation tests pass.
GENHIRE_OA_SECURITY_ACCEPTED="false"
# SAFE DEFAULT: Enable with supervised evaluation/execution worker. Keep evaluation running while draining already accepted attempts.
GENHIRE_OA_EVALUATION_ENABLED="false"
# SAFE DEFAULT: Shared code/SQL task dispatcher pilot range 1-4. SQL retains its separate one-execution limit.
GENHIRE_OA_EXECUTION_CONCURRENCY="2"
# SAFE DEFAULT: Shared queue bound, range 1-5000. Full queues return backpressure; unknown external POSTs must be reconciled.
GENHIRE_OA_EXECUTION_QUEUE_LIMIT="1000"
# SAFE DEFAULT: Maximum grading cases per attempt. This is not a provider monthly allowance.
GENHIRE_OA_GRADING_CASE_LIMIT="200"
# SAFE DEFAULT: Enable only after scoped launch/consent/preflight, kiosk/accommodation and retention checks.
GENHIRE_OA_INTEGRITY_ENABLED="false"
# SAFE DEFAULT: Enable after recruiter review/release/export/company-stage tests; no automatic company interview is performed.
GENHIRE_COMPANY_HIRING_ENABLED="false"
# SAFE DEFAULT: Enable paid mock purchase/start only after shared runtime, actual content acceptance and generation/advice worker readiness.
GENHIRE_MOCK_OA_ENABLED="false"
# SAFE DEFAULT: Operator assertion after actual role-question/explanation quality review; AI self-agreement alone is insufficient.
GENHIRE_MOCK_OA_CONTENT_ACCEPTED="false"
# SAFE DEFAULT: Must match installed/tested packaged runtime release; upload the matching signed installer and update public frontend download URL.
GENHIRE_OA_KIOSK_RELEASE_ID="1.3.0"
# SAFE DEFAULT: Optional sampled camera/dual images. Requires private GCS, signing permissions, models and real device tests; no continuous video claim.
GENHIRE_OA_MEDIA_ENABLED="false"
# SAFE DEFAULT: Operator assertion only after actual camera/phone/GCS/detector/retention acceptance.
GENHIRE_OA_MEDIA_ACCEPTED="false"
# SAFE DEFAULT: Raw evidence retention, supported 1-90 days; run retention worker and respect reasoned holds.
GENHIRE_OA_RAW_RETENTION_DAYS="30"
# SAFE DEFAULT: Summary retention, supported 30-730 days. Core scores/history follow separate policy.
GENHIRE_OA_SUMMARY_RETENTION_DAYS="180"
# SAFE DEFAULT: Optional; enable after a real independently reviewed/published pool and allocation verification.
GENHIRE_OA_VARIANTS_ENABLED="false"
# SAFE DEFAULT: Optional recruitment report after grading; human interpretation only, no objective-mark changes.
GENHIRE_OA_SIMILARITY_ENABLED="false"
# SAFE DEFAULT: Optional sampled desktop-camera extra, billable only when the implemented media tier is available.
GENHIRE_CAMERA_PROCTORING_CREDITS="10"

