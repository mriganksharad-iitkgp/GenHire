LANGCHAIN_TRACING_V2="false"
# Optional tracing service endpoint.
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ============================================================================
# OA owner configuration - server only, deployment/acceptance flags stay off
# ============================================================================
# SAFE DEFAULT: Keep false until transactional Mongo, scoped accounts and staging checks pass. Enables the workflow foundation, not all OA features.
GENHIRE_WORKFLOW_ENABLED="false"
# OWNER PRICE: No separate OA setup fee. Manual authoring is free; the complete AI JD + OA draft uses RECRUITER_AI_JD_CREDITS once.
GENHIRE_OA_JOB_SETUP_CREDITS="0"
# SAFE DEFAULT: Provisional owner-editable price: 30 wallet credits per accepted recruitment OA attempt. Review before publishing a paid job; existing pinned attempts are not repriced.
GENHIRE_OA_ATTEMPT_CREDITS="30"
# SAFE DEFAULT: 30 wallet credits per validated mock OA purchase including one attempt and basic educational advice.
GENHIRE_MOCK_OA_CREDITS="30"
# SAFE DEFAULT: Optional dual-camera extra, only when actual media/storage/device acceptance passes.
GENHIRE_DUAL_PROCTORING_CREDITS="10"
# SAFE DEFAULT: Reserved price only; deferred advanced analytics must stay hidden/nonbillable.
GENHIRE_ADVANCED_OA_ANALYTICS_CREDITS="10"
# SAFE DEFAULT: Credits per explicitly approved extra variant-generation batch; review/publish its content.
GENHIRE_EXTRA_VARIANTS_CREDITS="10"
# SAFE DEFAULT: Credits per approved recruitment similarity report; never an automatic cheating verdict. Practice similarity is deferred.
GENHIRE_PLAGIARISM_CHECK_CREDITS="10"
# SAFE DEFAULT: Enable only for deliberate real acceptance, then approved isolated execution. Tokens alone do not establish security.
GENHIRE_ASSESSMENT_EXECUTION_ENABLED="false"
