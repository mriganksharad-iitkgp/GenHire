# =====================================================
# Payment Module Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# -----------------------------------------------------
# Stripe Configuration (Required)
# -----------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys

# Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_51SnrQZKpLIjYKVjhvpVMK0w3MZTaW8VPYpW9geZ6KoeJNS6lcnbzUZe8oQkjuqqzVNOZWn4ie7bAPLrUq2X6DkDe00pwuappVY

# Publishable key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_51SnrQZKpLIjYKVjhn75oYHb07BYGXCBdUbYL2fnMEcmf9rHBZhk3yw6WTD2YjeuhZAppUJ6LeoqkfslQyTZ6SIq100iZ1RARZE

# Webhook secret (starts with whsec_)
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# -----------------------------------------------------
# MongoDB Configuration (Required)
# -----------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=hrtech

# -----------------------------------------------------
# Application URLs (Required for redirects)
# -----------------------------------------------------
FRONTEND_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# -----------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -----------------------------------------------------
# Payment Settings (Optional)
# -----------------------------------------------------
PAYMENT_CURRENCY=usd

# -----------------------------------------------------
# Flask Configuration (Optional)
# -----------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=your-flask-secret-key

# =====================================================
# Stripe Test Cards
# =====================================================
# Use these for testing:
# 
# SUCCESS:
#   Card: 4242 4242 4242 4242
#   Exp: Any future date
#   CVC: Any 3 digits
#
# DECLINE:
#   Card: 4000 0000 0000 0002
#
# REQUIRES_AUTH:
#   Card: 4000 0025 0000 3155
#
# INSUFFICIENT_FUNDS:
#   Card: 4000 0000 0000 9995
# =====================================================

# =====================================================
# Webhook Testing with Stripe CLI
# =====================================================
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Login: stripe login
# 3. Forward webhooks: stripe listen --forward-to localhost:5000/api/payment/webhooks/stripe
# 4. The CLI will show you a webhook secret - use that for STRIPE_WEBHOOK_SECRET
# =====================================================
