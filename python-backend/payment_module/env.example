# =====================================================
# Payment Module Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# -----------------------------------------------------
# Razorpay Configuration (Required)
# -----------------------------------------------------
# Get these from https://dashboard.razorpay.com/app/keys

# Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=rzp_test_S6C0kjbjNMJRLP

# Key Secret
RAZORPAY_KEY_SECRET=Rhn5DxdWZME9DHx3xnHrQtTR

# Webhook secret
# Get from https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------
# MongoDB Configuration (Required)
# -----------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=hrtech

# -----------------------------------------------------
# Application URLs (Required for redirects)
# -----------------------------------------------------
FRONTEND_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# -----------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -----------------------------------------------------
# Payment Settings (Optional)
# -----------------------------------------------------
PAYMENT_CURRENCY=inr

# -----------------------------------------------------
# Flask Configuration (Optional)
# -----------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=your-flask-secret-key

# =====================================================
# Razorpay Test Cards & UPI
# =====================================================
# Use these for testing in test mode:
# 
# SUCCESS:
#   Card: 4111 1111 1111 1111
#   Exp: Any future date
#   CVV: Any 3 digits
#
# UPI (Test Mode):
#   success@razorpay - Successful payment
#   failure@razorpay - Failed payment
#
# Net Banking:
#   Use any test credentials provided by Razorpay
# =====================================================

# =====================================================
# Webhook Testing
# =====================================================
# 1. Use ngrok or similar to expose local server
# 2. Add webhook URL in Razorpay Dashboard: https://dashboard.razorpay.com/app/webhooks
# 3. Select events: payment.captured, payment.failed, refund.created, order.paid
# 4. Copy the webhook secret to RAZORPAY_WEBHOOK_SECRET
# =====================================================
