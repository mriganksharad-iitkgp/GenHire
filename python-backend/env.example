# ==========================================
# AptiDude Backend Configuration
# ==========================================
# Copy this file to .env and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=hrtech

# ==========================================
# JWT Configuration
# ==========================================
# Generate a strong secret key for JWT tokens
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here-replace-with-random-string
JWT_EXPIRATION_DAYS=7

# ==========================================
# Flask Configuration
# ==========================================
# Generate a strong secret key for Flask sessions
FLASK_SECRET_KEY=your-flask-secret-key-replace-with-random-string

# ==========================================
# Email Verification Configuration
# ==========================================
# Set to 'false' during development to skip email verification
# Set to 'true' in production to require email verification
REQUIRE_EMAIL_VERIFICATION=true

# ==========================================
# Mailgun Email Service Configuration
# ==========================================
# Sign up at https://www.mailgun.com/
# For testing, use sandbox domain (no verification needed)
# For production, use verified domain

# Your Mailgun API key (found in Settings → API Keys)
MAILGUN_API_KEY=your-mailgun-api-key

# Your Mailgun domain (e.g., sandboxXXXXX.mailgun.org or yourdomain.com)
MAILGUN_DOMAIN=sandboxXXXXX.mailgun.org

# The "from" email address for sending emails
MAILGUN_FROM_EMAIL=noreply@sandboxXXXXX.mailgun.org

# ==========================================
# Frontend Configuration
# ==========================================
# URL of your React frontend (used for email verification and password reset links)
# Development: http://localhost:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ==========================================
# Google OAuth Configuration
# ==========================================
# Get credentials from https://console.cloud.google.com/
# 1. Create a project or select existing
# 2. Go to "APIs & Services" → "Credentials"
# 3. Create "OAuth 2.0 Client ID" for Web application
# 4. Add authorized JavaScript origins: http://localhost:5173
# 5. Copy the Client ID

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================================
# AI/LLM Configuration
# ==========================================
# For interview question generation
GROQ_API_KEY=your-groq-api-key

# ==========================================
# Google Cloud Text-to-Speech Configuration
# ==========================================
# For TalkingHead avatar lip-sync and speech synthesis
# Option 1: JSON string of service account key (recommended for production)
# Get service account key from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Either variable name works:
# GOOGLE_TTS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project",...}
# OR
# GOOGLE_TTS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Option 2: Path to service account key JSON file (for local development)
# Download service account key and place in backend directory
# GOOGLE_TTS_SERVICE_ACCOUNT_KEY=./path/to/service-account-key.json

# ==========================================
# File Upload Configuration
# ==========================================
UPLOAD_FOLDER=uploads

# ==========================================
# Development Notes
# ==========================================
# 
# Quick Start:
# 1. Copy this file to .env
# 2. Fill in at minimum:
#    - MONGODB_URI (if not using default)
#    - JWT_SECRET_KEY (generate random string)
#    - FLASK_SECRET_KEY (generate random string)
# 3. For email features, add Mailgun credentials
# 4. For Google OAuth, add GOOGLE_CLIENT_ID
# 5. Set REQUIRE_EMAIL_VERIFICATION=false for testing without emails
#
# Testing without Email:
# - Set REQUIRE_EMAIL_VERIFICATION=false
# - No need to configure Mailgun
# - Users can login immediately after registration
#
# Testing with Mailgun Sandbox:
# - Sign up at mailgun.com
# - Use sandbox domain (no verification needed)
# - Add test recipients in Mailgun dashboard → Authorized Recipients
# - Emails will only be sent to authorized recipients
#
# Google OAuth in Development:
# - Works with http://localhost:5173 (no HTTPS required)
# - Make sure to add localhost to authorized origins in Google Console
#

