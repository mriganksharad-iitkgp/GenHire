{
  "name": "genhire",
  "version": "1.3.0",
  "description": "GenHire secure interview browser",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "build:ui": "npm --prefix ../react-frontend run build:kiosk",
    "prebuild": "npm run build:ui",
    "prebuild:win": "npm run build:ui",
    "prebuild:mac": "npm run build:ui",
    "predist": "npm run build:ui",
    "predist:win": "npm run build:ui",
    "predist:mac": "npm run build:ui",
    "start:webgazer-test": "electron ./test-webgazer",
    "smoke:gaze": "npx --yes serve@14 . -l 3333",
    "test": "node --test tests/*.test.js",
    "test:face-runtime": "electron scripts/face-runtime-smoke.cjs",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "test:voice-runtime": "electron scripts/voice-runtime-smoke.cjs"
  },
  "build": {
    "appId": "com.genhire.securebrowser",
    "productName": "Genhire",
    "artifactName": "Genhire.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "runtime-security.js",
      "media-permissions.js",
      "web-app/**",
      "build/**",
      "package.json"
    ],
    "protocols": {
      "name": "Genhire Secure Interview URL",
      "schemes": [
        "secure-interview"
      ]
    },
    "asar": true,
    "compression": "maximum",
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "icon": "build/genhire_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/genhire_logo.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 220,
          "type": "file"
        }
      ]
    }
  },
  "keywords": [],
  "author": "CompanyXYZ",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^23.6.0"
  },
  "dependencies": {
    "electron-localshortcut": "^3.2.1"
  }
}
