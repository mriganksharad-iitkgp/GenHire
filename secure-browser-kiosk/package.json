{
  "name": "genhire",
  "version": "1.1.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:webgazer-test": "electron ./test-webgazer",
    "smoke:gaze": "npx --yes serve@14 . -l 3333",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.genhire.securebrowser",
    "productName": "Genhire",
    "artifactName": "Genhire.${ext}",
    "protocols": {
      "name": "Genhire Secure Interview URL",
      "schemes": [
        "secure-interview"
      ]
    },
    "asar": true,
    "compression": "maximum",
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "credentials.json",
        "to": "credentials.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/genhire_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/genhire_logo.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 220,
          "type": "file"
        }
      ]
    }
  },
  "keywords": [],
  "author": "CompanyXYZ",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^23.6.0"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "electron-localshortcut": "^3.2.1"
  }
}