{
  "name": "genhire",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:webgazer-test": "electron ./test-webgazer",
    "smoke:gaze": "npx --yes serve@14 . -l 3333",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.genhire.securebrowser",
    "productName": "Genhire",
    "artifactName": "Genhire.${ext}",
    "protocols": {
      "name": "Genhire Secure Interview URL",
      "schemes": [
        "secure-interview"
      ]
    },
    "asar": true,
    "compression": "maximum",
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "icon": "build/genhire_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "CompanyXYZ",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^23.6.0"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "electron-localshortcut": "^3.2.1"
  }
}