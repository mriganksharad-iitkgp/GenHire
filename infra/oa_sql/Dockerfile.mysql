FROM mysql:8.4
USER root
RUN microdnf install -y python3 python3-pip && microdnf clean all
WORKDIR /opt/genhire-sql
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir --target=/opt/pydeps -r requirements.txt
COPY runner.py .
ENV SQL_ENGINE=mysql SQL_ENGINE_VERSION=8.4 PYTHONPATH=/opt/pydeps
ENTRYPOINT ["python3", "/opt/genhire-sql/runner.py"]
